# Supabase › Project Settings › Data API / API Keys
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Cloudinary › Settings › API Keys
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Shared passcode for the two of you (leave empty to disable the lock)
APP_PASSCODE=
